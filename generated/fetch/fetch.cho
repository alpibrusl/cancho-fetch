edition 11;

// GENERATED by scripts/fetch_build.py for the hosts below -- do not edit. The hosts are the `Out` capability's bound, a
// literal, so each one has its own function; everything else is tools/fetch/fetchcore.cho.

import std.buffer;
import std.bytes;
import std.io;
import toolbox.cli;
import toolbox.describe;
import fetchcore;

fn hosts() -> [] &static [byte] {
    return "http://127.0.0.1:18080;http://127.0.0.1:18081";
}

fn roots() -> [] &static [byte] {
    return "";
}

fn credentials() -> [] &static [byte] {
    return "";
}

fn private_ok() -> [] bool {
    return true;
}

fn via_0[&h, &k, &o, &p, &y](heap: &!h Heap, clock: &k Clock, out: &o Out("127.0.0.1:18080"), plan: &p fetchcore.Plan, entropy: &y [byte]) -> [heap, clock, poll, net_out("127.0.0.1:18080")] fetchcore.Answer {
    match tcp_connect(out, fetchcore.dial_host(hosts(), 0), fetchcore.dial_port(hosts(), 0)) {
        Dialed::Ok(conn) => {
            return fetchcore.exchange(heap, clock, conn, plan, fetchcore.authority(hosts(), 0), hosts(), private_ok(), fetchcore.entry_secure(hosts(), 0), fetchcore.dial_host(hosts(), 0), roots(), entropy, "", "");
        }
        Dialed::Failed(errno) => {
            return fetchcore.dial_failed(heap, errno);
        }
    }
}

fn via_1[&h, &k, &o, &p, &y](heap: &!h Heap, clock: &k Clock, out: &o Out("127.0.0.1:18081"), plan: &p fetchcore.Plan, entropy: &y [byte]) -> [heap, clock, poll, net_out("127.0.0.1:18081")] fetchcore.Answer {
    match tcp_connect(out, fetchcore.dial_host(hosts(), 1), fetchcore.dial_port(hosts(), 1)) {
        Dialed::Ok(conn) => {
            return fetchcore.exchange(heap, clock, conn, plan, fetchcore.authority(hosts(), 1), hosts(), private_ok(), fetchcore.entry_secure(hosts(), 1), fetchcore.dial_host(hosts(), 1), roots(), entropy, "", "");
        }
        Dialed::Failed(errno) => {
            return fetchcore.dial_failed(heap, errno);
        }
    }
}

fn run[&h, &g, &i, &k, &z, &q0, &q1](heap: &!h Heap, args: &g Args, io: &!i Io, clock: &k Clock, entropy: &z [byte], o0: &q0 Out("127.0.0.1:18080"), o1: &q1 Out("127.0.0.1:18081")) -> [heap, args, io_write, err_write, clock, poll, net_out("127.0.0.1:18080"), net_out("127.0.0.1:18081")] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, fetchcore.tool(), fetchcore.built());
    }
    var plan = fetchcore.plan(heap, args, hosts());
    var refused = false;
    borrow plan as &r in {
        refused = fetchcore.refused(r);
    }
    var status = 0;
    if refused {
        borrow plan as &p in {
            status = fetchcore.refuse(heap, io, p);
        }
        fetchcore.drop_plan(heap, plan);
        return status;
    }
    var answer = fetchcore.nothing(heap);
    var finished = false;
    while !finished {
        borrow plan as &p in {
            let pick = fetchcore.host_of(p);
            if pick == 0 {
                answer = fetchcore.replace(heap, answer, via_0(heap, clock, o0, p, entropy));
            } else {
                answer = fetchcore.replace(heap, answer, via_1(heap, clock, o1, p, entropy));
            }
        }
        var again = false;
        borrow answer as &a in {
            again = fetchcore.follows(a);
        }
        if again {
            plan = fetchcore.retarget(heap, plan, answer, hosts());
            answer = fetchcore.nothing(heap);
        } else {
            finished = true;
        }
    }
    borrow plan as &p in {
        status = fetchcore.respond(heap, io, p, answer);
    }
    fetchcore.drop_plan(heap, plan);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(ports);
    release(signals);
    release(exec);
    release(tty);
    release(fs);
    let (o0, o1) = narrow(out, "127.0.0.1:18080", "127.0.0.1:18081");
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow mut io as &!i in {
                borrow clock as &k in {
                    region seed {
                        let entropy = alloc_slice[seed](32, byte_of(0));
                        borrow o0 as &r0 in {
                            borrow o1 as &r1 in {
                                status = run(h, g, i, k, entropy, r0, r1);
                            }
                        }
                    }
                }
            }
        }
    }
    release(o0);
    release(o1);
    release(clock);
    release(heap);
    release(args);
    release(io);
    return status;
}
