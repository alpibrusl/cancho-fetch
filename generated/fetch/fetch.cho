edition 11;

// GENERATED by scripts/fetch_build.py for the hosts below -- do not edit. The hosts are the `Out` capability's bound, a
// literal, so each one has its own function; everything else is tools/fetch/fetchcore.cho.

import std.buffer;
import std.io;
import toolbox.cli;
import toolbox.describe;
import fetchcore;

fn hosts() -> [] &static [byte] {
    return "http://127.0.0.1:18080;http://127.0.0.1:18081";
}

fn private_ok() -> [] bool {
    return true;
}

fn via_0[&h, &k, &o, &p](heap: &!h Heap, clock: &k Clock, out: &o Out("127.0.0.1:18080"), plan: &p fetchcore.Plan) -> [heap, clock, poll, net_out("127.0.0.1:18080")] fetchcore.Answer {
    match tcp_connect(out, fetchcore.dial_host(hosts(), 0), fetchcore.dial_port(hosts(), 0)) {
        Dialed::Ok(conn) => {
            return fetchcore.exchange(heap, clock, conn, plan, fetchcore.authority(hosts(), 0), private_ok());
        }
        Dialed::Failed(errno) => {
            return fetchcore.dial_failed(heap, errno);
        }
    }
}

fn via_1[&h, &k, &o, &p](heap: &!h Heap, clock: &k Clock, out: &o Out("127.0.0.1:18081"), plan: &p fetchcore.Plan) -> [heap, clock, poll, net_out("127.0.0.1:18081")] fetchcore.Answer {
    match tcp_connect(out, fetchcore.dial_host(hosts(), 1), fetchcore.dial_port(hosts(), 1)) {
        Dialed::Ok(conn) => {
            return fetchcore.exchange(heap, clock, conn, plan, fetchcore.authority(hosts(), 1), private_ok());
        }
        Dialed::Failed(errno) => {
            return fetchcore.dial_failed(heap, errno);
        }
    }
}

fn run[&h, &g, &i, &k, &q0, &q1](heap: &!h Heap, args: &g Args, io: &!i Io, clock: &k Clock, o0: &q0 Out("127.0.0.1:18080"), o1: &q1 Out("127.0.0.1:18081")) -> [heap, args, io_write, err_write, clock, poll, net_out("127.0.0.1:18080"), net_out("127.0.0.1:18081")] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, fetchcore.tool(), fetchcore.built());
    }
    let plan = fetchcore.plan(heap, args, hosts());
    var status = 0;
    borrow plan as &p in {
        if fetchcore.refused(p) {
            status = fetchcore.refuse(heap, io, p);
        } else {
            let pick = fetchcore.host_of(p);
            if pick == 0 {
                let answer = via_0(heap, clock, o0, p);
                status = fetchcore.respond(heap, io, p, answer);
            } else {
                let answer = via_1(heap, clock, o1, p);
                status = fetchcore.respond(heap, io, p, answer);
            }
        }
    }
    fetchcore.drop_plan(heap, plan);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(ports);
    release(signals);
    release(exec);
    release(tty);
    let (o0, o1) = narrow(out, "127.0.0.1:18080", "127.0.0.1:18081");
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow mut io as &!i in {
                borrow clock as &k in {
                    borrow o0 as &r0 in {
                        borrow o1 as &r1 in {
                            status = run(h, g, i, k, r0, r1);
                        }
                    }
                }
            }
        }
    }
    release(o0);
    release(o1);
    release(clock);
    release(heap);
    release(args);
    release(io);
    return status;
}
