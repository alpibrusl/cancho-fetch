edition 5;

module mcp.tools;

// Generated by scripts/mcp.py from the tool's `introspect` and the compiler's
// authority report of the server -- do not edit (docs/mcp.md §3). The
// `tools/list` result, and for tool `i` the tables a call is checked against:
// its properties as flags (`property|flag|kind`, kind `bool`, `nat` or `text`),
// its operands in order (`property|min|max`, `max` empty for unbounded), how
// standard input reaches it (none, or `text`: a property called `stdin`), its output (`document` or `stream`), and the
// property that chooses its format (the answer is structured content only when
// it is `json`). Then the server's bounds and the sentences it says when it
// ends a call, and `introspect`.

pub fn list_result() -> [] &static [byte] {
    return "{\"tools\":[{\"name\":\"fetch\",\"description\":\"Send one HTTP GET, HEAD or POST request to a host this build was given, and answer the status, the headers and the body. The hosts are in the binary and in its authority row; a request for any other host is refused before a socket opens. No redirects, credentials or cookies.\\n\\nThe hosts this tool can reach are baked into it; `host` selects among them and any other value is refused with the list. The answer is the tool's own output, byte for byte, and is bounded by the server. A refusal is an error result whose JSON names a `rule` and a `repair`; match on the rule. Redirects are not followed: a 3xx status is data.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\",\"minLength\":1,\"description\":\"which baked host to use: the host (or host:port) of one of this build's allowed entries, required when more than one is baked in This build's hosts are the enumerated values.\",\"enum\":[\"127.0.0.1:18080\",\"127.0.0.1:18081\"]},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":16777216,\"description\":\"the most response body bytes accepted (1 to 16777216), a larger body is fetch.body-too-large\",\"default\":1048576},\"timeout-ms\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":60000,\"description\":\"the deadline for the whole request once the name has resolved, in milliseconds (1 to 60000)\",\"default\":10000},\"accept\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the Accept request header\"},\"body\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the request body, for post (at most 65536 bytes)\"},\"content-type\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the Content-Type of the request body, required with --body\"},\"max-redirects\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":5,\"description\":\"how many redirects to follow (0 to 5), only to a host this build was given, a 3xx is otherwise the answer\",\"default\":0},\"format\":{\"enum\":[\"json\",\"text\"],\"description\":\"json for an envelope, text writes the response body to standard output\",\"default\":\"json\"},\"method\":{\"type\":\"string\",\"description\":\"get, head or post\"},\"path\":{\"type\":\"string\",\"description\":\"the request target: a path beginning with a single /, optionally with a query\"}},\"required\":[\"method\",\"path\"],\"additionalProperties\":false},\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":true,\"idempotentHint\":false,\"openWorldHint\":true}}]}";
}

pub fn count() -> [] int {
    return 1;
}

pub fn name(i: int) -> [] &static [byte] {
    if i == 0 {
        return "fetch";
    }
    return "";
}

pub fn flags(i: int) -> [] &static [byte] {
    if i == 0 {
        return "host|--host|text;max-bytes|--max-bytes|nat;timeout-ms|--timeout-ms|nat;accept|--accept|text;body|--body|text;content-type|--content-type|text;max-redirects|--max-redirects|nat;format|--format|text";
    }
    return "";
}

pub fn operands(i: int) -> [] &static [byte] {
    if i == 0 {
        return "method|1|1;path|1|1";
    }
    return "";
}

pub fn stdin(i: int) -> [] &static [byte] {
    if i == 0 {
        return "";
    }
    return "";
}

pub fn output(i: int) -> [] &static [byte] {
    if i == 0 {
        return "document";
    }
    return "";
}

pub fn structured(i: int) -> [] &static [byte] {
    if i == 0 {
        return "format";
    }
    return "";
}

// The binary, beneath the directory the server's `Exec` is narrowed to.
pub fn path(i: int) -> [] &static [byte] {
    if i == 0 {
        return "/opt/cancho-fetch/bin/fetch";
    }
    return "";
}

pub fn default_timeout() -> [] int {
    return 30000;
}

pub fn default_output() -> [] int {
    return 2097152;
}

pub fn default_input() -> [] int {
    return 1048576;
}

pub fn longest_line() -> [] int {
    return 4194304;
}

pub fn most_errors() -> [] int {
    return 65536;
}

// What the server tells a caller whose call it had to end (the `hint` of the error).
pub fn hint_too_large() -> [] &static [byte] {
    return "ask for less: the response body is capped by `max-bytes` (up to the tool's ceiling); the server's --max-output bounds the whole answer, so raise neither past what the task needs";
}

pub fn hint_timeout() -> [] &static [byte] {
    return "the host did not answer in time: `timeout-ms` is the tool's own deadline (up to 60000) and is shorter than the server's --timeout-ms; try the host later";
}

pub fn hint_input() -> [] &static [byte] {
    return "this tool takes no stdin; the bound is the server's --max-input";
}

// `mcp introspect`.
pub fn introspect() -> [] &static [byte] {
    return "{\"tool\":\"mcp\",\"version\":\"0.1.0\",\"compiler\":\"f4ead824f33b291a0ad7620a34a0c1346a7abe4f\",\"summary\":\"An MCP server (stdio, JSON-RPC 2.0) that serves the tool `fetch`: its input schema is derived from the tool's `introspect`, a call is a fixed argv with no shell, the answer is the tool's stdout, stderr and exit code unchanged, bounded in size and in time.\",\"usage\":\"mcp [--timeout-ms N] [--max-output N] [--max-input N] | mcp introspect\",\"output\":\"stdio\",\"protocol\":{\"transport\":\"stdio, one JSON-RPC 2.0 message per line\",\"version\":\"2025-06-18\",\"methods\":[\"initialize\",\"ping\",\"tools/list\",\"tools/call\"],\"notifications\":\"accepted and not answered\",\"max_line_bytes\":4194304},\"serves\":{\"tool\":\"fetch\",\"version\":\"0.1.0\",\"compiler\":\"f4ead824f33b291a0ad7620a34a0c1346a7abe4f\",\"bin\":\"/opt/cancho-fetch/bin\"},\"tools\":[\"fetch\"],\"flags\":[{\"name\":\"--timeout-ms\",\"kind\":\"nat\",\"role\":\"none\",\"default\":30000,\"help\":\"the deadline of one call: the tool is killed past it and the call ends as mcp.timeout\"},{\"name\":\"--max-output\",\"kind\":\"nat\",\"role\":\"none\",\"default\":2097152,\"help\":\"the most standard output of one call, in bytes: the tool is killed past it and the call ends as mcp.output-too-large\"},{\"name\":\"--max-input\",\"kind\":\"nat\",\"role\":\"none\",\"default\":1048576,\"help\":\"the most text of one call's `stdin` property, in decoded bytes: past it the call is refused before the tool starts, as mcp.input-too-large\"}],\"limits\":[{\"name\":\"timeout-ms\",\"default\":30000},{\"name\":\"max-output\",\"default\":2097152},{\"name\":\"max-input\",\"default\":1048576,\"note\":\"the `stdin` text of a call, in decoded bytes; the request line (below) bounds it from above\"},{\"name\":\"stderr\",\"default\":65536,\"note\":\"fixed: the tool's standard error beyond it ends the call as mcp.output-too-large\"},{\"name\":\"line\",\"default\":4194304,\"note\":\"fixed: a request line beyond it is refused as mcp.line-too-long\"}],\"rules\":[{\"rule\":\"mcp.parse-error\",\"answer\":\"jsonrpc -32700\",\"summary\":\"the line is not one JSON value\"},{\"rule\":\"mcp.invalid-request\",\"answer\":\"jsonrpc -32600\",\"summary\":\"not a JSON-RPC 2.0 request\"},{\"rule\":\"mcp.line-too-long\",\"answer\":\"jsonrpc -32600\",\"summary\":\"a request line longer than max_line_bytes\"},{\"rule\":\"mcp.unknown-method\",\"answer\":\"jsonrpc -32601\",\"summary\":\"a method other than initialize, ping, tools/list, tools/call\"},{\"rule\":\"mcp.unknown-tool\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a tool name other than fetch\"},{\"rule\":\"mcp.arguments-not-object\",\"answer\":\"jsonrpc -32602\",\"summary\":\"`arguments` is not an object\"},{\"rule\":\"mcp.unknown-argument\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a property the input schema does not have (data lists the real ones)\"},{\"rule\":\"mcp.wrong-type\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a property of the wrong type; every fault is listed in data.problems\"},{\"rule\":\"mcp.nul-in-argument\",\"answer\":\"jsonrpc -32602\",\"summary\":\"a NUL byte in a string, which would arrive as two arguments\"},{\"rule\":\"mcp.input-conflict\",\"answer\":\"jsonrpc -32602\",\"summary\":\"both `file` and `stdin` given: the call has one input (data.properties names them)\"},{\"rule\":\"mcp.input-missing\",\"answer\":\"jsonrpc -32602\",\"summary\":\"neither `file` nor `stdin` given: the call has no input (data.properties names them)\"},{\"rule\":\"mcp.input-too-large\",\"answer\":\"isError result\",\"summary\":\"the `stdin` text passed --max-input; this tool takes no stdin; the bound is the server's --max-input\"},{\"rule\":\"mcp.timeout\",\"answer\":\"isError result\",\"summary\":\"the call ran past --timeout-ms; the host did not answer in time: `timeout-ms` is the tool's own deadline (up to 60000) and is shorter than the server's --timeout-ms; try the host later\"},{\"rule\":\"mcp.output-too-large\",\"answer\":\"isError result\",\"summary\":\"the output passed --max-output (or the error stream passed its bound); ask for less: the response body is capped by `max-bytes` (up to the tool's ceiling); the server's --max-output bounds the whole answer, so raise neither past what the task needs\"},{\"rule\":\"mcp.signaled\",\"answer\":\"isError result\",\"summary\":\"the tool was ended by a signal\"},{\"rule\":\"mcp.spawn\",\"answer\":\"isError result\",\"summary\":\"the tool could not be started or watched\"}],\"confinement\":{\"network\":\"the server holds no Net and reads no file: only the tool reaches the network, for the hosts baked into it (the tool's introspect lists them), and flag values arrive as one `--name=value` argument and operands after `--`, with no shell\",\"exec\":\"the binary of the directory its Exec is narrowed to (baked at build time), by one fixed name\"},\"authority\":{\"bounded\":true,\"unbounded_by\":[],\"effects\":[\"args\",\"child_signal\",\"clock\",\"err_write\",\"exec\",\"heap\",\"io_read\",\"io_write\",\"pipe_read\",\"pipe_write\",\"poll\"],\"labels\":[{\"name\":\"args\",\"argument\":null,\"bounded\":true},{\"name\":\"child_signal\",\"argument\":null,\"bounded\":true},{\"name\":\"clock\",\"argument\":null,\"bounded\":true},{\"name\":\"err_write\",\"argument\":null,\"bounded\":true},{\"name\":\"exec\",\"argument\":\"/opt/cancho-fetch/bin\",\"bounded\":true},{\"name\":\"heap\",\"argument\":null,\"bounded\":true},{\"name\":\"io_read\",\"argument\":null,\"bounded\":true},{\"name\":\"io_write\",\"argument\":null,\"bounded\":true},{\"name\":\"pipe_read\",\"argument\":null,\"bounded\":true},{\"name\":\"pipe_write\",\"argument\":null,\"bounded\":true},{\"name\":\"poll\",\"argument\":null,\"bounded\":true}],\"never_touches\":[\"the filesystem\",\"the network\",\"signals\",\"foreign code\"],\"foreign_symbols\":[],\"pure\":[\"a_or_an\",\"abs\",\"at\",\"base\",\"bit_length\",\"bit_length_of\",\"bytes\",\"channels\",\"channels_with_errors\",\"child_token\",\"close\",\"compare\",\"count\",\"count\",\"count_byte\",\"decode\",\"default_input\",\"default_output\",\"default_timeout\",\"digit_of\",\"equal\",\"err_control\",\"err_depth\",\"err_end\",\"err_escape\",\"err_full\",\"err_number\",\"err_syntax\",\"err_trailing\",\"err_utf8\",\"errors_token\",\"escape_width\",\"exact_pow10\",\"exited\",\"expected_of\",\"failed\",\"fault_at\",\"field\",\"fine\",\"finish\",\"fits_int\",\"flags\",\"get\",\"hex4\",\"hex_digit\",\"hex_value\",\"hint_input\",\"hint_timeout\",\"hint_too_large\",\"in_range\",\"input_token\",\"introspect\",\"is_array\",\"is_bool\",\"is_digit\",\"is_digit\",\"is_int\",\"is_object\",\"is_string\",\"is_tail\",\"is_ws\",\"is_zero\",\"kind\",\"kind_name\",\"kind_of\",\"known\",\"ldexp\",\"lead_bits\",\"list\",\"list_result\",\"longest_line\",\"longest_line\",\"max_depth\",\"min\",\"most_errors\",\"name\",\"nat_of\",\"next_point\",\"operands\",\"output\",\"output_token\",\"parse_int\",\"path\",\"point_width\",\"pow2\",\"read_again\",\"read_end\",\"read_too_much\",\"rule_of\",\"running\",\"second_range\",\"shut\",\"signed\",\"size\",\"skip\",\"slow_decimal\",\"stdin\",\"string_equals\",\"string_length\",\"structured\",\"tape_len\",\"timed_out\",\"to_bool\",\"to_float\",\"to_int\",\"too_much\",\"wants_json\",\"width_of\",\"wrong\"],\"folded_operators\":49,\"folded_calls\":0,\"functions\":184}}";
}
